{
    "info": {
        "name": "Pathshala App API - Notices",
        "description": "Module 5: the notice feed (5.1), read marks (5.2), the teacher's audience options (5.3) and publishing (5.4). Run '0. Log in' first. The feed has the app's notices for the caller's role, class, section and group, plus the school website's public notices (ids like web-22). As the teacher, run 5.3 first: it saves class_id for 5.4. 5.4 sends a new Idempotency-Key each time; list fields can also be one comma-separated value. Every response is { status, message, data }; errors also have errors for bad fields. No push notification is sent yet.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://127.0.0.1:8000/api/v1"
        },
        {
            "key": "schl_id",
            "value": "8"
        },
        {
            "key": "otp",
            "value": "123456"
        },
        {
            "key": "pin",
            "value": "1234"
        },
        {
            "key": "flow_token",
            "value": ""
        },
        {
            "key": "student_mobile",
            "value": "01700000003"
        },
        {
            "key": "student_class_code",
            "value": "11"
        },
        {
            "key": "student_registration_id",
            "value": "107837"
        },
        {
            "key": "student_password",
            "value": ""
        },
        {
            "key": "student_token",
            "value": ""
        },
        {
            "key": "teacher_mobile",
            "value": "01700000004"
        },
        {
            "key": "teacher_username",
            "value": ""
        },
        {
            "key": "teacher_password",
            "value": ""
        },
        {
            "key": "teacher_token",
            "value": ""
        },
        {
            "key": "teacher_user_id",
            "value": ""
        },
        {
            "key": "notice_id",
            "value": ""
        },
        {
            "key": "class_id",
            "value": ""
        }
    ],
    "event": [
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "let body = {};",
                    "try { body = pm.response.json(); } catch (e) {}",
                    "if (body.data && body.data.flow_token) { pm.collectionVariables.set('flow_token', body.data.flow_token); }"
                ]
            }
        }
    ],
    "item": [
        {
            "name": "0. Log in",
            "item": [
                {
                    "name": "Student",
                    "item": [
                        {
                            "name": "Send OTP",
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "url": "{{base_url}}/auth/send-otp",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"mobile_number\": \"{{student_mobile}}\",\n    \"role\": \"student\"\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "Verify OTP",
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "url": "{{base_url}}/auth/verify-otp",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"mobile_number\": \"{{student_mobile}}\",\n    \"otp\": \"{{otp}}\",\n    \"role\": \"student\"\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "Check Student ID and class",
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "url": "{{base_url}}/auth/student/check",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"flow_token\": \"{{flow_token}}\",\n    \"schl_id\": {{schl_id}},\n    \"class_code\": {{student_class_code}},\n    \"student_id\": \"{{student_registration_id}}\"\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "Verify student password",
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "url": "{{base_url}}/auth/student/verify-password",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"flow_token\": \"{{flow_token}}\",\n    \"password\": \"{{student_password}}\"\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "Or: send contact OTP (password not known)",
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "url": "{{base_url}}/auth/student/send-contact-otp",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"flow_token\": \"{{flow_token}}\"\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "Or: verify contact OTP",
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "url": "{{base_url}}/auth/student/verify-contact-otp",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"flow_token\": \"{{flow_token}}\",\n    \"otp\": \"{{otp}}\"\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "Set PIN (saves student_token)",
                            "event": [
                                {
                                    "listen": "test",
                                    "script": {
                                        "type": "text/javascript",
                                        "exec": [
                                            "const body = pm.response.json();",
                                            "if (body.data && body.data.token !== undefined) { pm.collectionVariables.set('student_token', String(body.data.token)); }"
                                        ]
                                    }
                                }
                            ],
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "url": "{{base_url}}/auth/set-pin",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"flow_token\": \"{{flow_token}}\",\n    \"pin\": \"{{pin}}\",\n    \"pin_confirmation\": \"{{pin}}\"\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                }
                            }
                        }
                    ]
                },
                {
                    "name": "Teacher",
                    "item": [
                        {
                            "name": "Send OTP",
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "url": "{{base_url}}/auth/send-otp",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"mobile_number\": \"{{teacher_mobile}}\",\n    \"role\": \"teacher\"\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "Verify OTP",
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "url": "{{base_url}}/auth/verify-otp",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"mobile_number\": \"{{teacher_mobile}}\",\n    \"otp\": \"{{otp}}\",\n    \"role\": \"teacher\"\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "Verify teacher login",
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "url": "{{base_url}}/auth/teacher/verify",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"flow_token\": \"{{flow_token}}\",\n    \"schl_id\": {{schl_id}},\n    \"username\": \"{{teacher_username}}\",\n    \"password\": \"{{teacher_password}}\"\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "Set PIN (saves teacher_token, teacher_user_id)",
                            "event": [
                                {
                                    "listen": "test",
                                    "script": {
                                        "type": "text/javascript",
                                        "exec": [
                                            "const body = pm.response.json();",
                                            "if (body.data && body.data.token !== undefined) { pm.collectionVariables.set('teacher_token', String(body.data.token)); }",
                                            "if (body.data && body.data.user && body.data.user.id !== undefined) { pm.collectionVariables.set('teacher_user_id', String(body.data.user && body.data.user.id)); }"
                                        ]
                                    }
                                }
                            ],
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "url": "{{base_url}}/auth/set-pin",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"flow_token\": \"{{flow_token}}\",\n    \"pin\": \"{{pin}}\",\n    \"pin_confirmation\": \"{{pin}}\"\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                }
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "1. Student",
            "item": [
                {
                    "name": "5.1 My notices (saves notice_id)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const body = pm.response.json();",
                                    "if (body.data && body.data[0] && body.data[0].id) { pm.collectionVariables.set('notice_id', String(body.data[0] && body.data[0].id)); }"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{student_token}}"
                            }
                        ],
                        "url": "{{base_url}}/notices"
                    }
                },
                {
                    "name": "5.2 Mark as read",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{student_token}}"
                            }
                        ],
                        "url": "{{base_url}}/notices/{{notice_id}}/read"
                    }
                }
            ]
        },
        {
            "name": "2. Teacher",
            "item": [
                {
                    "name": "5.3 Audience options (saves class_id)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const body = pm.response.json();",
                                    "if (body.data && body.data.classes && body.data.classes[0] && body.data.classes[0].id) { pm.collectionVariables.set('class_id', String(body.data.classes && body.data.classes[0] && body.data.classes[0].id)); }"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{teacher_token}}"
                            }
                        ],
                        "url": "{{base_url}}/notices/audience-options"
                    }
                },
                {
                    "name": "5.4 Publish a notice",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{teacher_token}}"
                            },
                            {
                                "key": "Idempotency-Key",
                                "value": "notice-{{teacher_user_id}}-{{$timestamp}}"
                            }
                        ],
                        "url": "{{base_url}}/notices",
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "category",
                                    "value": "examination",
                                    "type": "text"
                                },
                                {
                                    "key": "priority",
                                    "value": "high",
                                    "type": "text"
                                },
                                {
                                    "key": "title",
                                    "value": "Half yearly exam routine",
                                    "type": "text"
                                },
                                {
                                    "key": "body",
                                    "value": "Exams start on 1 December.",
                                    "type": "text"
                                },
                                {
                                    "key": "audience_roles[]",
                                    "value": "students",
                                    "type": "text"
                                },
                                {
                                    "key": "audience_roles[]",
                                    "value": "guardians",
                                    "type": "text"
                                },
                                {
                                    "key": "audience_classes[]",
                                    "value": "{{class_id}}",
                                    "type": "text"
                                },
                                {
                                    "key": "audience_sections[]",
                                    "value": "",
                                    "type": "text",
                                    "disabled": true
                                },
                                {
                                    "key": "audience_groups[]",
                                    "value": "",
                                    "type": "text",
                                    "disabled": true
                                },
                                {
                                    "key": "publish_on",
                                    "value": "",
                                    "type": "text",
                                    "disabled": true
                                },
                                {
                                    "key": "expires_on",
                                    "value": "",
                                    "type": "text",
                                    "disabled": true
                                },
                                {
                                    "key": "files[]",
                                    "type": "file",
                                    "src": [],
                                    "disabled": true
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "5.1 My notices (teacher)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const body = pm.response.json();",
                                    "if (body.data && body.data[0] && body.data[0].id) { pm.collectionVariables.set('notice_id', String(body.data[0] && body.data[0].id)); }"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{teacher_token}}"
                            }
                        ],
                        "url": "{{base_url}}/notices"
                    }
                },
                {
                    "name": "5.2 Mark as read",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{teacher_token}}"
                            }
                        ],
                        "url": "{{base_url}}/notices/{{notice_id}}/read"
                    }
                }
            ]
        }
    ]
}
