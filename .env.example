APP_NAME="Pathshala App API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Dhaka

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# master = db_school_api_web. The tenant database name comes from
# school_information.db_name at runtime, on the same server and credentials.
DB_CONNECTION=master
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_school_api_web
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Signs the JWT and flow tokens. Changing it logs out every user.
JWT_SECRET=
# Secret salt shared by all users, added to the signing key. Changing it logs out every user.
TOKEN_SALT=
FLOW_TOKEN_TTL=3600

# Where homework uploads go. "public" needs php artisan storage:link. Files saved by the
# web system stay in the school's cloud bucket and are linked from institute_storage_path.
HW_FILES_DISK=public
HW_FILES_URL=

# log = no SMS yet. Remove OTP_FIXED when a real gateway is added.
OTP_DRIVER=log
OTP_FIXED=123456

# Attendance SMS to guardians (10.6), through each school's own gateway as the web register sends it.
# true only on the live server: anything else never sends a real SMS.
SMS_ENABLED=false
