{
    "info": {
        "name": "Pathshala App API - Student Profile",
        "description": "Module 1: student full profile (1.1), correction request (1.2) and the class teacher's class list (1.3). 1.2 sends a new Idempotency-Key each time (a timestamp); to see the replay rule, send it twice within the same second or set a fixed key. Run '0. Log in' first: it saves student_token, student_row_id, teacher_token and teacher_user_id. As the teacher, run '1.3 Class list' before '1.1 Profile of a student in my class': it saves the first class_student_id. The student can verify with the password or, if it is not known, with the contact OTP (also 123456 while OTP_FIXED is set). Every response is { status, message, data }; errors also have errors for bad fields. NID and birth registration are sent masked only (full is null). A teacher does not get guardian mobile, email or NID.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://127.0.0.1:8000/api/v1"
        },
        {
            "key": "schl_id",
            "value": "8"
        },
        {
            "key": "otp",
            "value": "123456"
        },
        {
            "key": "pin",
            "value": "1234"
        },
        {
            "key": "flow_token",
            "value": ""
        },
        {
            "key": "student_mobile",
            "value": "01700000003"
        },
        {
            "key": "student_class_code",
            "value": "11"
        },
        {
            "key": "student_registration_id",
            "value": "107837"
        },
        {
            "key": "student_password",
            "value": ""
        },
        {
            "key": "student_token",
            "value": ""
        },
        {
            "key": "student_row_id",
            "value": ""
        },
        {
            "key": "teacher_mobile",
            "value": "01700000004"
        },
        {
            "key": "teacher_username",
            "value": ""
        },
        {
            "key": "teacher_password",
            "value": ""
        },
        {
            "key": "teacher_token",
            "value": ""
        },
        {
            "key": "teacher_user_id",
            "value": ""
        },
        {
            "key": "class_student_id",
            "value": ""
        }
    ],
    "event": [
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "let body = {};",
                    "try { body = pm.response.json(); } catch (e) {}",
                    "if (body.data && body.data.flow_token) { pm.collectionVariables.set('flow_token', body.data.flow_token); }"
                ]
            }
        }
    ],
    "item": [
        {
            "name": "0. Log in",
            "item": [
                {
                    "name": "Student",
                    "item": [
                        {
                            "name": "Send OTP",
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "url": "{{base_url}}/auth/send-otp",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"mobile_number\": \"{{student_mobile}}\",\n    \"role\": \"student\"\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "Verify OTP",
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "url": "{{base_url}}/auth/verify-otp",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"mobile_number\": \"{{student_mobile}}\",\n    \"otp\": \"{{otp}}\",\n    \"role\": \"student\"\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "Check Student ID and class",
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "url": "{{base_url}}/auth/student/check",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"flow_token\": \"{{flow_token}}\",\n    \"schl_id\": {{schl_id}},\n    \"class_code\": {{student_class_code}},\n    \"student_id\": \"{{student_registration_id}}\"\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "Verify student password",
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "url": "{{base_url}}/auth/student/verify-password",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"flow_token\": \"{{flow_token}}\",\n    \"password\": \"{{student_password}}\"\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "Or: send contact OTP (password not known)",
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "url": "{{base_url}}/auth/student/send-contact-otp",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"flow_token\": \"{{flow_token}}\"\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "Or: verify contact OTP",
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "url": "{{base_url}}/auth/student/verify-contact-otp",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"flow_token\": \"{{flow_token}}\",\n    \"otp\": \"{{otp}}\"\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "Set PIN (saves student_token)",
                            "event": [
                                {
                                    "listen": "test",
                                    "script": {
                                        "type": "text/javascript",
                                        "exec": [
                                            "const body = pm.response.json();",
                                            "if (body.data && body.data.token !== undefined) { pm.collectionVariables.set('student_token', String(body.data.token)); }"
                                        ]
                                    }
                                }
                            ],
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "url": "{{base_url}}/auth/set-pin",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"flow_token\": \"{{flow_token}}\",\n    \"pin\": \"{{pin}}\",\n    \"pin_confirmation\": \"{{pin}}\"\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "Profile (saves student_row_id)",
                            "event": [
                                {
                                    "listen": "test",
                                    "script": {
                                        "type": "text/javascript",
                                        "exec": [
                                            "const body = pm.response.json();",
                                            "if (body.data && body.data.placement && body.data.placement.homework_student_id) { pm.collectionVariables.set('student_row_id', String(body.data.placement && body.data.placement.homework_student_id)); }"
                                        ]
                                    }
                                }
                            ],
                            "request": {
                                "method": "GET",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    },
                                    {
                                        "key": "Authorization",
                                        "value": "Bearer {{student_token}}"
                                    }
                                ],
                                "url": "{{base_url}}/auth/me"
                            }
                        }
                    ]
                },
                {
                    "name": "Teacher",
                    "item": [
                        {
                            "name": "Send OTP",
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "url": "{{base_url}}/auth/send-otp",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"mobile_number\": \"{{teacher_mobile}}\",\n    \"role\": \"teacher\"\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "Verify OTP",
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "url": "{{base_url}}/auth/verify-otp",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"mobile_number\": \"{{teacher_mobile}}\",\n    \"otp\": \"{{otp}}\",\n    \"role\": \"teacher\"\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "Verify teacher login",
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "url": "{{base_url}}/auth/teacher/verify",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"flow_token\": \"{{flow_token}}\",\n    \"schl_id\": {{schl_id}},\n    \"username\": \"{{teacher_username}}\",\n    \"password\": \"{{teacher_password}}\"\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "name": "Set PIN (saves teacher_token, teacher_user_id)",
                            "event": [
                                {
                                    "listen": "test",
                                    "script": {
                                        "type": "text/javascript",
                                        "exec": [
                                            "const body = pm.response.json();",
                                            "if (body.data && body.data.token !== undefined) { pm.collectionVariables.set('teacher_token', String(body.data.token)); }",
                                            "if (body.data && body.data.user && body.data.user.id !== undefined) { pm.collectionVariables.set('teacher_user_id', String(body.data.user && body.data.user.id)); }"
                                        ]
                                    }
                                }
                            ],
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "url": "{{base_url}}/auth/set-pin",
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"flow_token\": \"{{flow_token}}\",\n    \"pin\": \"{{pin}}\",\n    \"pin_confirmation\": \"{{pin}}\"\n}",
                                    "options": {
                                        "raw": {
                                            "language": "json"
                                        }
                                    }
                                }
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "1. Student",
            "item": [
                {
                    "name": "1.1 My profile",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{student_token}}"
                            }
                        ],
                        "url": "{{base_url}}/students/{{student_row_id}}/profile"
                    }
                },
                {
                    "name": "1.2 Ask for a correction",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{student_token}}"
                            },
                            {
                                "key": "Idempotency-Key",
                                "value": "profile-change-{{student_row_id}}-{{$timestamp}}"
                            }
                        ],
                        "url": "{{base_url}}/students/{{student_row_id}}/profile/change-requests",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"field\": \"Blood group\",\n    \"requested_value\": \"A+\",\n    \"note\": \"Lab report attached\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    }
                }
            ]
        },
        {
            "name": "2. Teacher",
            "item": [
                {
                    "name": "1.3 Class list (saves class_student_id)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const body = pm.response.json();",
                                    "if (body.data && body.data[0] && body.data[0].student_id) { pm.collectionVariables.set('class_student_id', String(body.data[0] && body.data[0].student_id)); }"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{teacher_token}}"
                            }
                        ],
                        "url": "{{base_url}}/teacher/my-class/students"
                    }
                },
                {
                    "name": "1.1 Profile of a student in my class",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{teacher_token}}"
                            }
                        ],
                        "url": "{{base_url}}/students/{{class_student_id}}/profile"
                    }
                }
            ]
        }
    ]
}
